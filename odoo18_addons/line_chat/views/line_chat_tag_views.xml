<odoo>
  <record id="line_chat_tag_tree" model="ir.ui.view">
    <field name="name">line.chat.tag.tree</field>
    <field name="model">line.chat.tag</field>
    <field name="arch" type="xml">
        <list editable="top">
            <field name="name"/>
            <!-- <field name="color"/> -->
        </list>
    </field>
  </record>

  <record id="line_chat_tag_action" model="ir.actions.act_window">
      <field name="name">Property Tag</field>
      <field name="res_model">line.chat.tag</field>
      <field name="view_mode">list,form</field>
  </record>

  <menuitem id="line_chat_tag_menu"
        name="顧客標籤"
        parent="line_chat_menu_root"
        action="line_chat_tag_action"
        sequence="20"
        groups="base.group_user"/>
</odoo>
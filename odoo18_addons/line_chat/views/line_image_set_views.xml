<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="line_image_set_view_form" model="ir.ui.view">
        <field name="name">line.image.set.form</field>
        <field name="model">line.image.set</field>
        <field name="arch" type="xml">
            <form string="圖片set">
                <sheet>
                    <group>
                        <field name="image_set_id"/>
                        <field name="message_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="line_image_set_view_list" model="ir.ui.view">
        <field name="name">line.image.set.list</field>
        <field name="model">line.image.set</field>
        <field name="arch" type="xml">
            <list string="圖片set與id對照">
                <field name="image_set_id"/>
                <field name="message_id"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="line_image_set_action" model="ir.actions.act_window">
        <field name="name">圖片訊息</field>
        <field name="res_model">line.image.set</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>查看目前圖片訊息與對照id。</p>
        </field>
    </record>

    <!-- Menu -->
    <!-- <menuitem id="line_chat_menu_root"
              name="LINE 聊天"
              sequence="10"
              groups="base.group_user"/> -->

    <menuitem id="line_image_set_menu"
              name="圖片set狀態"
              parent="line_chat_menu_root"
              action="line_image_set_action"
              sequence="20"
              groups="base.group_user"/>

</odoo>

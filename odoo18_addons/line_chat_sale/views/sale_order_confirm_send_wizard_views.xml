<odoo>
  <record id="view_sale_order_confirm_send_wizard_form" model="ir.ui.view">
    <field name="name">sale.order.confirm.send.wizard.form</field>
    <field name="model">sale.order.confirm.send.wizard</field>
    <field name="arch" type="xml">
      <form string="確認發送報價單？">
        <group>
          <field name="message" readonly="1"/>
        </group>
        <footer>
          <button name="confirm_action" string="確定" type="object" class="btn-primary"/>
          <button string="取消" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
